{
	acme_ca {$CADDY_ACME_CA}
}

# zrok2 controller API and web console
zrok2.{$ZROK2_DNS_ZONE} {
	reverse_proxy zrok2-controller:18080
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}
}

# Public shares
*.{$ZROK2_DNS_ZONE} {
	reverse_proxy zrok2-frontend:8080
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}
}
