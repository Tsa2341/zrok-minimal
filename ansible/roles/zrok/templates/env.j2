# Managed by Ansible (zrok-minimal). Changes here are overwritten.
ZROK2_DNS_ZONE={{ zrok_dns_zone }}
ZROK2_ADMIN_TOKEN={{ zrok2_admin_token }}
ZITI_PWD={{ ziti_pwd }}
RABBITMQ_PASSWORD={{ rabbitmq_password }}
CLOUDFLARE_API_TOKEN={{ cloudflare_api_token }}
CADDY_ACME_CA={{ caddy_acme_ca }}
CADDY_IMAGE={{ caddy_image }}
ZROK2_TAG={{ zrok2_tag }}
ZITI_TAG={{ ziti_tag }}
RABBITMQ_TAG={{ rabbitmq_tag }}
ZROK2_OAUTH_GOOGLE_CLIENT_ID={{ oauth_google_client_id }}
ZROK2_OAUTH_GOOGLE_CLIENT_SECRET={{ oauth_google_client_secret }}
ZROK2_OAUTH_SIGNING_KEY={{ oauth_signing_key if oauth_google_client_id else '' }}
ZROK2_OAUTH_ENCRYPTION_KEY={{ oauth_encryption_key if oauth_google_client_id else '' }}
